diff --git a/tests/bpsQuota.test.ts b/tests/bpsQuota.test.ts
new file mode 100644
index 0000000..a305f6f
--- /dev/null
+++ b/tests/bpsQuota.test.ts
@@ -0,0 +1,133 @@
+import { describe, expect, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import i18n from '@/i18n';
+import { I18nextProvider } from 'react-i18next';
+import type { AntigravityQuotaSummaryPayload, PluginQuotaMetric, PluginQuotaState } from '@/types';
+import { buildAntigravityQuotaGroups } from '@/utils/quota';
+import { buildBpsQuotaEstimates } from '@/features/quota/providers/plugin/bpsQuota';
+import { PluginQuotaBody } from '@/features/quota/providers/plugin/PluginQuotaBody';
+import { QUOTA_CLASS_KEYS, bindQuotaClasses } from '@/features/quota/types';
+
+const classes = bindQuotaClasses(
+  Object.fromEntries(QUOTA_CLASS_KEYS.map((key) => [key, key])),
+  'test'
+);
+const metric = (index: number, kind: string, value: number): PluginQuotaMetric => ({
+  key: `bps_estimated_${index}_${kind}_usd`,
+  label: `raw-estimate-${kind}`,
+  value,
+  format: 'currency',
+  currency: 'USD',
+});
+const payload: AntigravityQuotaSummaryPayload = {
+  groups: [
+    {
+      displayName: 'Account usage',
+      buckets: [
+        { window: '7d', remainingFraction: 0.75, resetTime: '2099-01-01T00:00:00Z' },
+        { window: '5h', remainingFraction: 0.4 },
+      ],
+    },
+    { displayName: 'Code review', buckets: [{ window: '7d', remainingFraction: 0.9 }] },
+  ],
+};
+const summary = [
+  metric(0, 'total', 100),
+  metric(0, 'remaining', 75),
+  metric(1, 'total', 20),
+  metric(1, 'remaining', 8),
+];
+const state = (): PluginQuotaState => ({
+  status: 'success',
+  pluginId: 'bps',
+  summary,
+  groups: buildAntigravityQuotaGroups(payload),
+  bpsEstimates: buildBpsQuotaEstimates(payload, summary),
+});
+const chinese = i18n.cloneInstance({ lng: 'zh-CN' });
+const render = (quota: PluginQuotaState) =>
+  renderToStaticMarkup(
+    createElement(
+      I18nextProvider,
+      { i18n: chinese },
+      createElement(PluginQuotaBody, { quota, classes })
+    )
+  );
+
+describe('BPS compact quota presentation', () => {
+  test('maps estimates by original window identity even when rendered order changes', () => {
+    expect(buildBpsQuotaEstimates(payload, summary)).toEqual({
+      '7d': { total: 100, remaining: 75 },
+      '5h': { total: 20, remaining: 8 },
+    });
+    const quota = state();
+    quota.groups[0].buckets.reverse();
+    const markup = render(quota);
+    expect(markup).toContain('data-bps-window="7d"');
+    expect(markup).toContain('aria-valuenow="25"');
+    expect(markup).toContain('aria-valuenow="60"');
+    expect(markup.match(/≈/g)?.length).toBe(4);
+    expect(markup).not.toContain('class="quotaBar"');
+    expect(markup).not.toContain('raw-estimate-total');
+    expect(markup).toContain('估算总额');
+    expect(markup).toContain('已用 25%');
+  });
+
+  test('renders empty and exhausted quotas in the correct used-percent direction', () => {
+    const quota = state();
+    quota.groups = buildAntigravityQuotaGroups({
+      groups: [
+        {
+          displayName: 'Account usage',
+          buckets: [
+            { window: '5h', remainingFraction: 1 },
+            { window: '7d', remainingFraction: 0 },
+          ],
+        },
+      ],
+    });
+    quota.bpsEstimates = {};
+    const markup = render(quota);
+    expect(markup).toContain('aria-valuenow="0"');
+    expect(markup).toContain('aria-valuenow="100"');
+    expect(markup).toContain('width:0%');
+    expect(markup).toContain('width:100%');
+    expect(markup).toContain(chinese.t('plugin_quota.bps_estimate_pending'));
+    expect(markup).not.toContain('$0.00');
+  });
+
+  test('rejects partial, nonfinite, negative and inconsistent estimates', () => {
+    for (const metrics of [
+      [metric(0, 'total', 100)],
+      [metric(0, 'total', NaN), metric(0, 'remaining', 75)],
+      [metric(0, 'total', 100), metric(0, 'remaining', -1)],
+      [metric(0, 'total', 100), metric(0, 'remaining', 101)],
+    ])
+      expect(buildBpsQuotaEstimates(payload, metrics)).toEqual({});
+    expect(
+      buildBpsQuotaEstimates(payload, [metric(0, 'total', 100), metric(0, 'remaining', 0)])['7d']
+        .remaining
+    ).toBe(0);
+  });
+
+  test('keeps other plugins on their existing renderer', () => {
+    const quota = state();
+    quota.pluginId = 'another-plugin';
+    const markup = render(quota);
+    expect(markup).not.toContain('data-bps-quota-layout');
+    expect(markup).toContain('class="quotaBar"');
+    expect(markup).toContain('raw-estimate-total');
+  });
+
+  test('preserves credits without presenting them as dollars', () => {
+    const quota = state();
+    quota.summary = [
+      ...summary,
+      { key: 'credits_balance', label: 'Credits balance', value: 40, unit: 'credits' },
+    ];
+    const markup = render(quota);
+    expect(markup).toContain('40 ' + chinese.t('plugin_quota.bps_credit_unit'));
+    expect(markup).not.toContain('$40.00');
+  });
+});
diff --git a/tests/bpsQuotaAutoRefresh.test.ts b/tests/bpsQuotaAutoRefresh.test.ts
new file mode 100644
index 0000000..584c65f
--- /dev/null
+++ b/tests/bpsQuotaAutoRefresh.test.ts
@@ -0,0 +1,86 @@
+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test';
+import i18n from '@/i18n';
+import { apiClient } from '@/services/api/client';
+import { useQuotaStore } from '@/stores/useQuotaStore';
+import { getQuotaCacheKey } from '@/utils/quota/identity';
+import { refreshBpsQuotaAutomatically } from '@/features/quota/providers/plugin/useBpsQuotaAutoRefresh';
+import { PLUGIN_CONFIG } from '@/features/quota/providers/plugin/data';
+
+const file = {
+  name: 'fixture.json',
+  authIndex: 'fixture-index',
+  type: 'bps',
+  quotaPluginId: 'bps',
+  supportsQuota: true,
+};
+const payload = {
+  observedAt: '2026-11-26T00:00:00Z',
+  stale: false,
+  groups: [{ displayName: 'Account usage', buckets: [{ window: '7d', remainingFraction: 0.52 }] }],
+  summary: [{ key: 'rate_limit_reset_credits_available_count', label: 'credits', value: 1 }],
+};
+const mocks: Array<{ mockRestore(): void }> = [];
+beforeEach(() => useQuotaStore.getState().clearQuotaCache());
+afterEach(() => {
+  for (const mock of mocks.splice(0)) mock.mockRestore();
+  useQuotaStore.getState().clearQuotaCache();
+});
+
+describe('BPS automatic quota refresh', () => {
+  test('loads without clicking, shares concurrent requests and throttles reads', async () => {
+    const post = spyOn(apiClient, 'post').mockResolvedValue(payload);
+    mocks.push(post);
+    await Promise.all(
+      Array.from({ length: 10 }, () => refreshBpsQuotaAutomatically(file, i18n.t, 1000))
+    );
+    await refreshBpsQuotaAutomatically(file, i18n.t, 2000);
+    expect(post).toHaveBeenCalledTimes(1);
+    const quota = useQuotaStore.getState().pluginQuota[getQuotaCacheKey(file)];
+    expect(quota.status).toBe('success');
+    expect(quota.observedAt).toBe(payload.observedAt);
+    expect(quota.groups.length).toBe(1);
+    await refreshBpsQuotaAutomatically(file, i18n.t, 61000);
+    expect(post).toHaveBeenCalledTimes(2);
+  });
+  test('retains the snapshot during refresh and on failure, but disables stale resets', async () => {
+    const post = spyOn(apiClient, 'post').mockResolvedValue(payload);
+    mocks.push(post);
+    await refreshBpsQuotaAutomatically(file, i18n.t, 1000);
+    const key = getQuotaCacheKey(file);
+    const before = useQuotaStore.getState().pluginQuota[key];
+    useQuotaStore
+      .getState()
+      .setPluginQuota((prev) => ({ ...prev, [key]: PLUGIN_CONFIG.buildLoadingState() }));
+    expect(useQuotaStore.getState().pluginQuota[key].groups).toEqual(before.groups);
+    useQuotaStore.getState().setPluginQuota((prev) => ({ ...prev, [key]: before }));
+    post.mockRejectedValue(new Error('offline'));
+    await refreshBpsQuotaAutomatically(file, i18n.t, 61000);
+    const after = useQuotaStore.getState().pluginQuota[key];
+    expect(after.groups).toEqual(before.groups);
+    expect(after.observedAt).toBe(before.observedAt);
+    expect(after.stale).toBe(true);
+    expect(PLUGIN_CONFIG.canResetQuota!(after)).toBe(false);
+  });
+  test('does not restore a response after logout or credential invalidation', async () => {
+    let resolve!: (value: typeof payload) => void;
+    const post = spyOn(apiClient, 'post').mockImplementation(
+      () =>
+        new Promise((done) => {
+          resolve = done;
+        })
+    );
+    mocks.push(post);
+    const pending = refreshBpsQuotaAutomatically(file, i18n.t, 1000);
+    useQuotaStore.getState().clearQuotaCache();
+    resolve(payload);
+    await pending;
+    expect(useQuotaStore.getState().pluginQuota).toEqual({});
+  });
+  test('does not poll disabled or unrelated credentials', async () => {
+    const post = spyOn(apiClient, 'post').mockResolvedValue(payload);
+    mocks.push(post);
+    await refreshBpsQuotaAutomatically({ ...file, disabled: true }, i18n.t, 1000);
+    await refreshBpsQuotaAutomatically({ ...file, quotaPluginId: 'other' }, i18n.t, 1000);
+    expect(post).not.toHaveBeenCalled();
+  });
+});
diff --git a/tests/bpsQuotaReset.test.ts b/tests/bpsQuotaReset.test.ts
new file mode 100644
index 0000000..f7199ab
--- /dev/null
+++ b/tests/bpsQuotaReset.test.ts
@@ -0,0 +1,92 @@
+import { afterEach, describe, expect, spyOn, test } from 'bun:test';
+import i18n from '@/i18n';
+import { apiClient } from '@/services/api/client';
+import { PLUGIN_CONFIG, resetBpsQuota } from '@/features/quota/providers/plugin/data';
+import type { PluginQuotaState } from '@/types';
+
+const file = {
+  name: 'bps-test.json',
+  auth_index: 'fixture-index',
+  type: 'bps',
+  quotaPluginId: 'bps',
+};
+const mocks: Array<{ mockRestore(): void }> = [];
+afterEach(() => {
+  for (const mock of mocks.splice(0)) mock.mockRestore();
+});
+
+describe('BPS quota reset', () => {
+  test('shows the shared reset action only for a known available BPS credit', () => {
+    const state: PluginQuotaState = { status: 'success', pluginId: 'bps', groups: [], summary: [] };
+    expect(PLUGIN_CONFIG.canResetQuota!(state)).toBe(false);
+    for (const value of [0, -1, NaN, 1.5]) {
+      state.summary = [
+        { key: 'rate_limit_reset_credits_available_count', label: 'Reset count', value },
+      ];
+      expect(PLUGIN_CONFIG.canResetQuota!(state)).toBe(false);
+    }
+    state.summary[0].value = 2;
+    expect(PLUGIN_CONFIG.canResetQuota!(state)).toBe(true);
+    state.pluginId = 'other';
+    expect(PLUGIN_CONFIG.canResetQuota!(state)).toBe(false);
+  });
+
+  test('resets the selected credential once, then refreshes its quota', async () => {
+    const calls: string[] = [];
+    const reset = spyOn(apiClient, 'delete').mockImplementation(async () => {
+      calls.push('reset');
+      return { status: 'ok', auth_index: 'fixture-index' };
+    });
+    const read = spyOn(apiClient, 'post').mockImplementation(async () => {
+      calls.push('read');
+      return { groups: [], summary: [] };
+    });
+    mocks.push(reset, read);
+    const result = await resetBpsQuota(file, i18n.t);
+    expect(calls).toEqual(['reset', 'read']);
+    expect(reset).toHaveBeenCalledWith('/plugins/bps/quota', {
+      params: { auth_index: 'fixture-index' },
+    });
+    expect(read).toHaveBeenCalledWith('/plugins/bps/quota', { auth_index: 'fixture-index' });
+    expect(result.pluginId).toBe('bps');
+  });
+
+  test('does not retry an unconfirmed redemption or refresh another credential', async () => {
+    const reset = spyOn(apiClient, 'delete').mockResolvedValue({
+      status: 'ok',
+      auth_index: 'other',
+    });
+    const read = spyOn(apiClient, 'post').mockResolvedValue({});
+    mocks.push(reset, read);
+    await expect(resetBpsQuota(file, i18n.t)).rejects.toThrow();
+    expect(reset).toHaveBeenCalledTimes(1);
+    expect(read).not.toHaveBeenCalled();
+  });
+
+  test('distinguishes a successful reset from a failed balance refresh', async () => {
+    const reset = spyOn(apiClient, 'delete').mockResolvedValue({
+      status: 'ok',
+      auth_index: 'fixture-index',
+    });
+    const read = spyOn(apiClient, 'post').mockRejectedValue(new Error('offline'));
+    mocks.push(reset, read);
+    await expect(resetBpsQuota(file, i18n.t)).rejects.toThrow(
+      i18n.t('plugin_quota.bps_reset_refresh_failed')
+    );
+    expect(reset).toHaveBeenCalledTimes(1);
+  });
+
+  test('stops follow-up work after the active connection changes', async () => {
+    const revision = spyOn(apiClient, 'getConnectionRevision')
+      .mockReturnValueOnce(1)
+      .mockReturnValue(2);
+    const reset = spyOn(apiClient, 'delete').mockResolvedValue({
+      status: 'ok',
+      auth_index: 'fixture-index',
+    });
+    const read = spyOn(apiClient, 'post').mockResolvedValue({});
+    mocks.push(revision, reset, read);
+    await expect(resetBpsQuota(file, i18n.t)).rejects.toThrow();
+    expect(read).not.toHaveBeenCalled();
+  });
+});
