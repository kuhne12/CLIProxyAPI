+  assertConnection();
+  if (result.status !== 'ok' || result.auth_index !== authIndex) {
+    throw new Error(t('codex_quota.reset_not_confirmed'));
+  }
+  try {
+    // The v8 reset endpoint clears routing cooldown only after upstream confirmation.
+    const data = await fetchPluginQuota(file, t);
+    assertConnection();
+    return data;
+  } catch {
+    throw new Error(t('plugin_quota.bps_reset_refresh_failed'));
+  }
