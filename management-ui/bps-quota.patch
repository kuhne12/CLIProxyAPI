diff --git a/src/features/quota/providers/plugin/useBpsQuotaAutoRefresh.ts b/src/features/quota/providers/plugin/useBpsQuotaAutoRefresh.ts
new file mode 100644
index 0000000..8cb3c5f
--- /dev/null
+++ b/src/features/quota/providers/plugin/useBpsQuotaAutoRefresh.ts
@@ -0,0 +1,109 @@
+import { useEffect } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { TFunction } from 'i18next';
+import type { AuthFileItem } from '@/types';
+import { apiClient } from '@/services/api/client';
+import {
+  captureQuotaCacheGeneration,
+  commitIfQuotaCacheCurrent,
+  useQuotaStore,
+} from '@/stores/useQuotaStore';
+import { getQuotaCacheKey } from '@/utils/quota/identity';
+import { selectedQuotaPluginId, getStatusFromError } from '@/utils/quota';
+import { isRuntimeOnlyAuthFile } from '@/features/authFiles/constants';
+import { fetchPluginQuota, PLUGIN_CONFIG } from './data';
+
+const attempts = new Map<string, { at: number; promise: Promise<void> }>();
+let sessionKey = '';
+const refreshInterval = 60_000;
+
+export function refreshBpsQuotaAutomatically(
+  file: AuthFileItem,
+  t: TFunction,
+  now = Date.now()
+): Promise<void> {
+  if (file.disabled || isRuntimeOnlyAuthFile(file) || selectedQuotaPluginId(file) !== 'bps')
+    return Promise.resolve();
+  const store = useQuotaStore.getState();
+  const session = JSON.stringify([apiClient.getConnectionRevision(), store.cacheGeneration]);
+  if (session !== sessionKey) {
+    attempts.clear();
+    sessionKey = session;
+  }
+  const cacheKey = getQuotaCacheKey(file);
+  const key = JSON.stringify([cacheKey, store.fileGenerations[file.name] ?? 0]);
+  const previous = attempts.get(key);
+  if (previous && now - previous.at < refreshInterval) return previous.promise;
+  if (store.pluginQuota[cacheKey]?.status === 'loading') return Promise.resolve();
+  const generation = captureQuotaCacheGeneration(file.name);
+  store.setPluginQuota((prev) => ({ ...prev, [cacheKey]: PLUGIN_CONFIG.buildLoadingState() }));
+  const promise = (async () => {
+    try {
+      const data = await fetchPluginQuota(file, t);
+      commitIfQuotaCacheCurrent(generation, () => {
+        useQuotaStore
+          .getState()
+          .setPluginQuota((prev) => ({
+            ...prev,
+            [cacheKey]: PLUGIN_CONFIG.buildSuccessState(data),
+          }));
+      });
+    } catch (error) {
+      commitIfQuotaCacheCurrent(generation, () => {
+        useQuotaStore
+          .getState()
+          .setPluginQuota((prev) => ({
+            ...prev,
+            [cacheKey]: PLUGIN_CONFIG.buildErrorState(
+              error instanceof Error ? error.message : t('common.unknown_error'),
+              getStatusFromError(error),
+              error
+            ),
+          }));
+      });
+    }
+  })();
+  attempts.set(key, { at: now, promise });
+  // Avoid retaining visited credentials indefinitely on long-running panels.
+  for (const [candidate, attempt] of attempts) {
+    if (now - attempt.at > 10 * refreshInterval) attempts.delete(candidate);
+  }
+  return promise;
+}
+
+export function useBpsQuotaAutoRefresh(files: AuthFileItem[], disabled: boolean) {
+  const { t } = useTranslation();
+  const generation = useQuotaStore((state) => state.cacheGeneration);
+  const fileGenerations = useQuotaStore((state) => state.fileGenerations);
+  useEffect(() => {
+    if (disabled) return;
+    let cancelled = false;
+    let busy = false;
+    const refresh = async () => {
+      if (cancelled || busy || document.visibilityState === 'hidden') return;
+      busy = true;
+      const pending = files.filter((file) => selectedQuotaPluginId(file) === 'bps');
+      try {
+        await Promise.all(
+          Array.from({ length: Math.min(4, pending.length) }, async () => {
+            while (!cancelled && pending.length > 0) {
+              const file = pending.shift();
+              if (file) await refreshBpsQuotaAutomatically(file, t);
+            }
+          })
+        );
+      } finally {
+        busy = false;
+      }
+    };
+    void refresh();
+    const interval = window.setInterval(() => void refresh(), refreshInterval);
+    const onVisible = () => void refresh();
+    document.addEventListener('visibilitychange', onVisible);
+    return () => {
+      cancelled = true;
+      window.clearInterval(interval);
+      document.removeEventListener('visibilitychange', onVisible);
+    };
+  }, [files, disabled, t, generation, fileGenerations]);
+}
