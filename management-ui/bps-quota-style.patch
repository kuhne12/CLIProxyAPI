@@ -0,0 +1,52 @@
+import type { ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { IconChevronDown } from '@/components/ui/icons';
+import styles from './QuotaBalanceDetails.module.scss';
+
+interface QuotaBalanceDetailsProps {
+  balance: string | number | null;
+  unlimited?: boolean;
+  preview?: ReactNode;
+  children?: ReactNode;
+}
+
+/** Read-only balance details shared by Codex and BPS in both quota hosts. */
+export function QuotaBalanceDetails({
+  balance,
+  unlimited = false,
+  children,
+  preview,
+}: QuotaBalanceDetailsProps) {
+  const { t } = useTranslation();
+  const value = unlimited
+    ? t('codex_quota.credit_unlimited')
+    : balance === null
+      ? t('quota_balance.unavailable')
+      : `${balance} ${t('quota_balance.credit_unit')}`;
+
+  return (
+    <details className={styles.details} data-quota-balance="">
+      <summary className={styles.trigger} aria-label={t('quota_balance.view') + ' · ' + value}>
+        <span>{t('quota_balance.view')}</span>
+        <span className={styles.value} title={value}>
+          {preview ?? (unlimited || balance === null ? value : balance)}
+        </span>
+        <IconChevronDown size={14} className={styles.chevron} aria-hidden="true" />
+      </summary>
+      <div className={styles.content}>
+        <div className={styles.row}>
+          <span>{t('quota_balance.label')}</span>
+          <strong>{value}</strong>
+        </div>
+        <p className={styles.note}>
+          {t(
+            balance === null && !unlimited
+              ? 'quota_balance.not_returned'
+              : 'quota_balance.credits_help'
+          )}
+        </p>
+        {children}
+      </div>
+    </details>
+  );
+}
