+.body {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  min-width: 0;
+}
+
+.group {
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+}
+
+.heading {
+  display: flex;
+  align-items: center;
+  color: var(--text-tertiary);
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.window {
+  min-width: 0;
+}
+
+.estimates {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 6px;
+  margin-bottom: 5px;
+}
+
+.stat {
+  padding: 2px 5px;
+  border-radius: $radius-sm;
+  background: color-mix(in srgb, var(--text-primary) 5%, transparent);
+  color: var(--text-tertiary);
+  font-size: 10px;
+  line-height: 1.5;
+
+  strong {
+    margin-left: 3px;
+    font-family: $font-mono;
+    font-variant-numeric: tabular-nums;
+    color: var(--text-secondary);
+    font-weight: 550;
+  }
+}
+
+.pending {
+  color: var(--text-tertiary);
+  font-size: 10px;
+  margin-bottom: 5px;
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 5px 7px;
+  min-width: 0;
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+}
+
+.badge {
+  min-width: 30px;
+  max-width: 100px;
+  padding: 2px 5px;
+  border-radius: $radius-sm;
+  background: color-mix(in srgb, var(--text-primary) 7%, transparent);
+  color: var(--text-secondary);
+  font-family: $font-mono;
+  font-weight: 600;
+  text-align: center;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.track {
+  width: 60px;
+  height: 6px;
+  flex-shrink: 0;
+  overflow: hidden;
+  border-radius: $radius-full;
+  background: color-mix(in srgb, var(--text-primary) 10%, transparent);
+}
+
+.fill {
+  height: 100%;
+  background: currentColor;
+  border-radius: inherit;
+  transition: width 300ms var(--ease-out-strong, ease);
+}
+
+.percent {
+  white-space: nowrap;
+}
+.healthy {
+  color: var(--viz-success);
+}
+.warning {
+  color: var(--quota-medium-color);
+}
+.danger {
+  color: var(--viz-failure);
+}
+.reset {
+  color: var(--text-tertiary);
+  white-space: nowrap;
+  font-size: 10px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .fill {
+    transition: none;
+  }
+}
diff --git a/src/features/quota/providers/plugin/BpsQuotaBody.tsx b/src/features/quota/providers/plugin/BpsQuotaBody.tsx
new file mode 100644
index 0000000..93eaf4b
--- /dev/null
+++ b/src/features/quota/providers/plugin/BpsQuotaBody.tsx
@@ -0,0 +1,183 @@
+import { useTranslation } from 'react-i18next';
+import { InfoTip } from '@/components/ui/Tooltip';
+import { useNow } from '@/hooks/useNow';
+import { buildResetDisplay } from '@/utils/quota';
+import type { PluginQuotaState } from '@/types';
+import type { QuotaBodyProps } from '../../types';
+import { isBpsEstimateMetric } from './bpsQuota';
+import styles from './BpsQuotaBody.module.scss';
+
+export function BpsQuotaBody({ quota, classes }: QuotaBodyProps<PluginQuotaState>) {
+  const { t, i18n } = useTranslation();
+  const hasReset = quota.groups.some((group) => group.buckets.some((bucket) => bucket.resetTime));
+  const now = useNow(hasReset || Boolean(quota.observedAt)) + (quota.serverTimeOffsetMs ?? 0);
+  const observed = Date.parse(quota.observedAt ?? '');
+  const stale =
+    quota.stale ||
+    (Number.isFinite(observed) && now - (quota.serverTimeOffsetMs ?? 0) - observed > 120_000);
+  const plan =
+    quota.subscription?.tierName || quota.subscription?.plan || quota.subscription?.tierId;
+  const resetCredits = quota.summary.find(
+    (metric) => metric.key === 'rate_limit_reset_credits_available_count'
+  );
+  const resetCount =
+    resetCredits && Number.isSafeInteger(resetCredits.value) && resetCredits.value >= 0
+      ? resetCredits.value
+      : null;
+  const summary = quota.summary.filter(
+    (metric) =>
+      !isBpsEstimateMetric(metric) && metric.key !== 'rate_limit_reset_credits_available_count'
+  );
+  const windowLabel = (window: string) => {
+    const match = /^(\d+)([dhms])$/.exec(window);
+    const keys: Record<string, string> = {
+      d: 'bps_days',
+      h: 'bps_hours',
+      m: 'bps_minutes',
+      s: 'bps_seconds',
+    };
+    return match ? t('plugin_quota.' + keys[match[2]], { count: Number(match[1]) }) : window;
+  };
+  const money = new Intl.NumberFormat(i18n.resolvedLanguage, {
+    style: 'currency',
+    currency: 'USD',
+    currencyDisplay: 'narrowSymbol',
+  });
+
+  return (
+    <div className={styles.body} data-bps-quota-layout="compact-v1">
+      <div className={classes.quotaMessage} role="status">
+        {Number.isFinite(observed)
+          ? t('plugin_quota.bps_updated_at', {
+              time: new Date(observed).toLocaleString(i18n.resolvedLanguage),
+            })
+          : t('plugin_quota.bps_auto_refresh')}
+        {stale && <span> · {t('plugin_quota.bps_stale_snapshot')}</span>}
+      </div>
+      {
+        <div className={classes.codexPlan}>
+          {plan && (
+            <span className={classes.codexPlanItem} data-quota-plan="">
+              <span className={classes.codexPlanLabel}>{t('plugin_quota.plan_label')}</span>
+              <span className={classes.codexPlanValue}>{plan}</span>
+            </span>
+          )}
+          <span className={classes.codexPlanItem} data-bps-reset-count="">
+            <span className={classes.codexPlanLabel}>{t('codex_quota.reset_credits_label')}</span>
+            <span className={classes.codexPlanValue}>
+              {resetCount === null ? t('plugin_quota.bps_unknown') : resetCount}
+            </span>
+          </span>
+          {summary.map((metric) => (
+            <span key={metric.key} className={classes.codexPlanItem}>
+              <span className={classes.codexPlanLabel}>
+                {metric.key === 'credits_balance'
+                  ? t('plugin_quota.bps_credit_balance')
+                  : metric.label}
+              </span>
+              <span className={classes.codexPlanValue}>
+                {new Intl.NumberFormat(
+                  i18n.resolvedLanguage,
+                  metric.format === 'currency' && metric.currency
+                    ? { style: 'currency', currency: metric.currency }
+                    : { maximumFractionDigits: 2 }
+                ).format(metric.value)}
+                {metric.unit
+                  ? ` ${metric.unit === 'credits' ? t('plugin_quota.bps_credit_unit') : metric.unit}`
+                  : ''}
+              </span>
+            </span>
+          ))}
+        </div>
+      }
+      {quota.groups.length === 0 && !plan && summary.length === 0 && resetCount === null && (
+        <div className={classes.quotaMessage}>{t('plugin_quota.empty_data')}</div>
+      )}
+      {quota.groups.map((group) => {
+        const account = group.label === 'Account usage';
+        const groupLabel = account
+          ? t('plugin_quota.bps_account_usage')
+          : group.label === 'Code review'
+            ? t('plugin_quota.bps_code_review')
+            : group.label === 'Credits'
+              ? t('plugin_quota.bps_credit_balance')
+              : group.label;
+        return (
+          <div key={group.id} className={styles.group}>
+            <div className={styles.heading}>
+              {groupLabel}
+              {account && (
+                <InfoTip
+                  content={t('plugin_quota.bps_estimate_help')}
+                  label={t('plugin_quota.bps_estimate_label')}
+                />
+              )}
+            </div>
+            {group.buckets.map((bucket) => {
+              const used =
+                Math.round((1 - Math.min(1, Math.max(0, bucket.remainingFraction))) * 1000) / 10;
+              const window = bucket.window || bucket.label;
+              const estimate =
+                account && bucket.window ? quota.bpsEstimates?.[bucket.window] : undefined;
+              const resetAt =
+                bucket.resetAtMs ?? (bucket.resetTime ? Date.parse(bucket.resetTime) : NaN);
+              const reset = Number.isFinite(resetAt)
+                ? buildResetDisplay(null, resetAt, now, i18n.resolvedLanguage)
+                : null;
+              const tone =
+                used >= 90 ? styles.danger : used >= 75 ? styles.warning : styles.healthy;
+              const percent = t('plugin_quota.bps_used_percent', { percent: used });
+              return (
+                <div key={bucket.id} className={styles.window} data-bps-window={window}>
+                  {estimate ? (
+                    <div className={styles.estimates}>
+                      <span className={styles.stat}>
+                        {t('plugin_quota.bps_estimated_remaining')}{' '}
+                        <strong>≈ {money.format(estimate.remaining)}</strong>
+                      </span>
+                      <span className={styles.stat}>
+                        {t('plugin_quota.bps_estimated_total')}{' '}
+                        <strong>≈ {money.format(estimate.total)}</strong>
+                      </span>
+                    </div>
+                  ) : account ? (
+                    <div className={styles.pending}>{t('plugin_quota.bps_estimate_pending')}</div>
+                  ) : null}
+                  <div className={styles.row}>
+                    <span className={styles.badge} title={windowLabel(window)}>
+                      {windowLabel(window)}
+                    </span>
+                    <div
+                      className={`${styles.track} ${tone}`}
+                      role="progressbar"
+                      aria-label={`${groupLabel} ${window}`}
+                      aria-valuemin={0}
+                      aria-valuemax={100}
+                      aria-valuenow={used}
+                      aria-valuetext={percent}
+                    >
+                      <div className={styles.fill} style={{ width: `${used}%` }} />
+                    </div>
+                    <span className={`${styles.percent} ${tone}`}>{percent}</span>
+                    {reset && (
+                      <span
+                        className={styles.reset}
+                        title={
+                          bucket.resetTime
+                            ? new Date(bucket.resetTime).toLocaleString(i18n.resolvedLanguage)
+                            : undefined
+                        }
+                      >
+                        {t('plugin_quota.bps_resets', { time: reset.relative || reset.absolute })}
+                      </span>
+                    )}
+                  </div>
+                </div>
+              );
+            })}
+          </div>
+        );
+      })}
+    </div>
+  );
+}
