diff --git a/src/features/quota/providers/codex/planLabel.ts b/src/features/quota/providers/codex/planLabel.ts
new file mode 100644
index 0000000..1d65f9a
--- /dev/null
+++ b/src/features/quota/providers/codex/planLabel.ts
@@ -0,0 +1,23 @@
+import type { TFunction } from 'i18next';
+import {
+  normalizePlanType,
+  BUSINESS_PREMIUM_CODEX_PLAN_TYPE,
+  PRO_CODEX_PLAN_TYPE,
+  PRO_LITE_CODEX_PLAN_TYPES,
+  PRO_MAX_CODEX_PLAN_TYPES,
+} from '@/utils/quota';
+
+/** BPS exposes the same plan identifiers as Codex. */
+export function getCodexPlanLabel(plan: string | null | undefined, t: TFunction): string | null {
+  const normalized = normalizePlanType(plan);
+  if (!normalized) return null;
+  if (normalized === BUSINESS_PREMIUM_CODEX_PLAN_TYPE)
+    return t('codex_quota.plan_business_premium');
+  if (PRO_MAX_CODEX_PLAN_TYPES.has(normalized)) return t('codex_quota.plan_promax');
+  if (normalized === PRO_CODEX_PLAN_TYPE) return t('codex_quota.plan_pro');
+  if (PRO_LITE_CODEX_PLAN_TYPES.has(normalized)) return t('codex_quota.plan_prolite');
+  if (normalized === 'plus') return t('codex_quota.plan_plus');
+  if (normalized === 'team') return t('codex_quota.plan_team');
+  if (normalized === 'free') return t('codex_quota.plan_free');
+  return plan || normalized;
+}
