+
+describe('auth file concurrency', () => {
+  const patch = (providerKey: string, maxConcurrency: string, previous?: number) =>
+    buildAuthFileFieldsPatch({ ...makeEditor(previous ? { max_concurrency: previous } : {}, ''), providerKey, maxConcurrency }, resolveError);
+  test('persists file overrides and restores the inherited limit', () => {
+    expect(patch('bps', '2')).toEqual({ max_concurrency: 2 });
+    expect(patch('bps', '', 2)).toEqual({ max_concurrency: null });
+    expect(patch('codex', '8', 8)).toEqual({});
+    expect(patch('codex', '8')).toEqual({ max_concurrency: 8 });
+  });
+  test('rejects BPS overflow, fractional and zero limits', () => {
+    for (const limit of ['5','0','1.5']) expect(() => patch('bps', limit)).toThrow('auth_files.concurrency_invalid');
+  });
+});
