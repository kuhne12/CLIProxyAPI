+import type { AntigravityQuotaSummaryPayload, PluginQuotaMetric } from '@/types';
+import type { TFunction } from 'i18next';
+import { buildAntigravityQuotaGroups } from '@/utils/quota';
+
+// BPS emits explicit durations (7d, 5h, 30m), not Antigravity's weekly aliases.
+// Estimate descriptions are explanatory text, never a window's display label.
+export function buildBpsQuotaGroups(payload: AntigravityQuotaSummaryPayload, t: TFunction) {
+  const groupKeys: Record<string, string> = {
+    'Account usage': 'bps_account_usage',
+    'Code review': 'bps_code_review',
+    Credits: 'bps_credit_balance',
+  };
+  const units: Record<string, { seconds: number; key: string }> = {
+    d: { seconds: 86400, key: 'bps_days' },
+    h: { seconds: 3600, key: 'bps_hours' },
+    m: { seconds: 60, key: 'bps_minutes' },
+    s: { seconds: 1, key: 'bps_seconds' },
+  };
+  return buildAntigravityQuotaGroups(payload).map((group) => ({
+    ...group,
+    buckets: group.buckets.map((bucket) => {
+      const match = /^([1-9]\d*)([dhms])$/.exec(bucket.window ?? '');
+      const count = match ? Number(match[1]) : 0;
+      const unit = match ? units[match[2]] : undefined;
+      const seconds = unit ? count * unit.seconds : 0;
+      const validDuration = Number.isSafeInteger(seconds) && seconds > 0;
+      const groupLabel = groupKeys[group.label]
+        ? t('plugin_quota.' + groupKeys[group.label])
+        : group.label;
+      const windowLabel =
+        validDuration && unit ? t('plugin_quota.' + unit.key, { count }) : bucket.window;
+      return {
+        ...bucket,
+        label: windowLabel ? `${groupLabel} · ${windowLabel}` : groupLabel,
+        periodHours: validDuration ? seconds / 3600 : bucket.periodHours,
+      };
+    }),
+  }));
+}
+
+export interface BpsQuotaEstimate {
+  total: number;
+  remaining: number;
+}
+
+// Metric indices refer to the original account buckets, before the UI sorts them.
+export function buildBpsQuotaEstimates(
+  payload: AntigravityQuotaSummaryPayload,
+  summary: PluginQuotaMetric[]
+): Record<string, BpsQuotaEstimate> {
+  const estimates: Record<string, BpsQuotaEstimate> = {};
+  const buckets = payload.groups?.find(
+    (group) => (group.displayName ?? group.display_name) === 'Account usage'
+  )?.buckets;
+  if (!Array.isArray(buckets)) return estimates;
+  const metrics = new Map(summary.map((metric) => [metric.key, metric]));
+  buckets.forEach((bucket, index) => {
+    const window = bucket.window?.trim();
+    if (!window || buckets.filter((item) => item.window?.trim() === window).length !== 1) return;
+    const total = metrics.get(`bps_estimated_${index}_total_usd`);
+    const remaining = metrics.get(`bps_estimated_${index}_remaining_usd`);
+    if (
+      !total ||
+      !remaining ||
+      total.format !== 'currency' ||
+      remaining.format !== 'currency' ||
+      total.currency !== 'USD' ||
+      remaining.currency !== 'USD' ||
+      !Number.isFinite(total.value) ||
+      total.value <= 0 ||
+      !Number.isFinite(remaining.value) ||
+      remaining.value < 0 ||
+      remaining.value > total.value
+    )
+      return;
+    estimates[window] = { total: total.value, remaining: remaining.value };
+  });
+  return estimates;
+}
+
+export function isBpsEstimateMetric(metric: PluginQuotaMetric): boolean {
+  return /^bps_estimated_[0-9]+_(remaining|total)_usd$/.test(metric.key);
+}
