diff --git a/web/src/lib/credential-email.ts b/web/src/lib/credential-email.ts
new file mode 100644
index 0000000..f21fe60
--- /dev/null
+++ b/web/src/lib/credential-email.ts
@@ -0,0 +1,23 @@
+export interface CredentialIdentity { id: string; auth_index: string; email?: string }
+
+function email(value?: string) {
+  const candidate = value?.trim() || "";
+  return /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(candidate) ? candidate : "";
+}
+
+export function credentialDirectory(rows: CredentialIdentity[]) {
+  const byIndex = new Map<string, string>();
+  const byId = new Map<string, string>();
+  for (const row of rows) {
+    const address = email(row.email);
+    if (!address) continue;
+    if (row.auth_index) byIndex.set(row.auth_index, address);
+    if (row.id) byId.set(row.id, address);
+  }
+  return { byIndex, byId };
+}
+
+export function credentialEmail(record: { auth_type: string; source: string; auth_index: string; auth_id: string }, directory?: ReturnType<typeof credentialDirectory>) {
+  const recorded = record.auth_type === "oauth" ? email(record.source) : "";
+  return recorded || directory?.byIndex.get(record.auth_index) || directory?.byId.get(record.auth_id) || "";
+}
diff --git a/web/src/lib/latency-health.ts b/web/src/lib/latency-health.ts
new file mode 100644
index 0000000..d61ce51
--- /dev/null
+++ b/web/src/lib/latency-health.ts
@@ -0,0 +1,20 @@
+export type Severity = 'good' | 'warn' | 'slow' | 'critical';
+
+function grade(value: number, warn: number, slow: number, critical: number): Severity {
+  if (value >= critical) return 'critical';
+  if (value >= slow) return 'slow';
+  if (value >= warn) return 'warn';
+  return 'good';
+}
+
+export function latencyHealth(firstMs: number | null, totalMs: number, output: number) {
+  const total = grade(totalMs, 60000, 180000, 300000);
+  const hasRate = Number.isFinite(output) && output > 0 && Number.isFinite(totalMs) && totalMs > 0;
+  // sub2api uses wall time, with a fixed allowance plus time per output token.
+  return {
+    first: firstMs === null ? total : grade(firstMs, 10000, 30000, 60000),
+    total,
+    rate: hasRate ? grade(totalMs, 10000 + output * 50, 30000 + output * 100, 60000 + output * 200) : total,
+    tps: hasRate ? output * 1000 / totalMs : null,
+  };
+}
diff --git a/web/tests/credential-latency.test.mjs b/web/tests/credential-latency.test.mjs
new file mode 100644
index 0000000..b597f12
--- /dev/null
+++ b/web/tests/credential-latency.test.mjs
@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { latencyHealth } from '../src/lib/latency-health.ts';
+import { credentialDirectory, credentialEmail } from '../src/lib/credential-email.ts';
+
+test('sub2api thresholds include their boundaries and missing segments inherit duration', () => {
+ for (const [ms,grade] of [[9999,'good'],[10000,'warn'],[30000,'slow'],[60000,'critical']]) assert.equal(latencyHealth(ms,2000,0).first,grade);
+ for (const [ms,grade] of [[59999,'good'],[60000,'warn'],[180000,'slow'],[300000,'critical']]) assert.deepEqual(latencyHealth(null,ms,0),{first:grade,total:grade,rate:grade,tps:null});
+ for (const [ms,grade] of [[14999,'good'],[15000,'warn'],[40000,'slow'],[80000,'critical']]) assert.equal(latencyHealth(null,ms,100).rate,grade);
+});
+test('historical email wins and unknown API-key material stays out of the credential cell', () => {
+ const dir=credentialDirectory([{id:'a',auth_index:'i',email:'current@example.test'}]);
+ const row={auth_type:'oauth',auth_id:'a',auth_index:'i',source:'old@example.test'};
+ assert.equal(credentialEmail(row,dir),'old@example.test');
+ assert.equal(credentialEmail({...row,source:''},dir),'current@example.test');
+ assert.equal(credentialEmail({...row,auth_type:'api_key',source:'private@example.test',auth_id:'',auth_index:''},dir),'');
+});
