+.body {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  min-width: 0;
+}
+
+.group {
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+}
+
+.heading {
+  display: flex;
+  align-items: center;
+  color: var(--text-tertiary);
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.window {
+  min-width: 0;
+}
+
+.estimates {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 6px;
+  margin-bottom: 5px;
+}
+
+.stat {
+  padding: 2px 5px;
+  border-radius: $radius-sm;
+  background: color-mix(in srgb, var(--text-primary) 5%, transparent);
+  color: var(--text-tertiary);
+  font-size: 10px;
+  line-height: 1.5;
+
+  strong {
+    margin-left: 3px;
+    font-family: $font-mono;
+    font-variant-numeric: tabular-nums;
+    color: var(--text-secondary);
+    font-weight: 550;
+  }
+}
+
+.pending {
+  color: var(--text-tertiary);
+  font-size: 10px;
+  margin-bottom: 5px;
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 5px 7px;
+  min-width: 0;
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+}
+
+.badge {
+  min-width: 30px;
+  max-width: 100px;
+  padding: 2px 5px;
+  border-radius: $radius-sm;
+  background: color-mix(in srgb, var(--text-primary) 7%, transparent);
+  color: var(--text-secondary);
+  font-family: $font-mono;
+  font-weight: 600;
+  text-align: center;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.track {
+  width: 60px;
+  height: 6px;
+  flex-shrink: 0;
+  overflow: hidden;
+  border-radius: $radius-full;
+  background: color-mix(in srgb, var(--text-primary) 10%, transparent);
+}
+
+.fill {
+  height: 100%;
+  background: currentColor;
+  border-radius: inherit;
+  transition: width 300ms var(--ease-out-strong, ease);
+}
+
+.percent {
+  white-space: nowrap;
+}
+.healthy {
+  color: var(--viz-success);
+}
+.warning {
+  color: var(--quota-medium-color);
+}
+.danger {
+  color: var(--viz-failure);
+}
+.reset {
+  color: var(--text-tertiary);
+  white-space: nowrap;
+  font-size: 10px;
