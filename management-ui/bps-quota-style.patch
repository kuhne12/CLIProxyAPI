+@use '../../../styles/mixins' as *;
+
+.details {
+  min-width: 0;
+  border-block: 1px solid var(--border-color);
+  font-size: 11px;
+}
+
+.trigger {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 0;
+  color: var(--text-secondary);
+  cursor: pointer;
+  list-style: none;
+
+  &::-webkit-details-marker {
+    display: none;
+  }
+  &:hover {
+    color: var(--text-primary);
+  }
+  &:focus-visible {
+    outline: 2px solid var(--primary-color);
+    outline-offset: 3px;
+    border-radius: 3px;
+  }
+}
+
+.value {
+  margin-left: auto;
+  font-family: $font-mono;
+  font-variant-numeric: tabular-nums;
+  color: var(--text-primary);
+  overflow-wrap: anywhere;
+  text-align: right;
+  min-width: 0;
+}
+
+.chevron {
+  flex-shrink: 0;
+}
+.details[open] .chevron {
+  transform: rotate(180deg);
+}
+.content {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding-bottom: 10px;
+}
+.row {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  color: var(--text-secondary);
+}
+.row strong {
+  font-family: $font-mono;
+  color: var(--text-primary);
+  overflow-wrap: anywhere;
+  text-align: right;
+}
+.note {
+  margin: 0;
+  line-height: 1.5;
+  color: var(--text-tertiary);
+}
+
+[data-quota-glance] .details {
+  display: none;
+}
diff --git a/src/features/quota/components/QuotaBalanceDetails.tsx b/src/features/quota/components/QuotaBalanceDetails.tsx
