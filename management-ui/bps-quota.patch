diff --git a/src/features/quota/providers/plugin/bpsQuota.ts b/src/features/quota/providers/plugin/bpsQuota.ts
new file mode 100644
index 0000000..fe61d0f
--- /dev/null
+++ b/src/features/quota/providers/plugin/bpsQuota.ts
@@ -0,0 +1,45 @@
+import type { AntigravityQuotaSummaryPayload, PluginQuotaMetric } from '@/types';
+
+export interface BpsQuotaEstimate {
+  total: number;
+  remaining: number;
+}
+
+// Metric indices refer to the original account buckets, before the UI sorts them.
+export function buildBpsQuotaEstimates(
+  payload: AntigravityQuotaSummaryPayload,
+  summary: PluginQuotaMetric[]
+): Record<string, BpsQuotaEstimate> {
+  const estimates: Record<string, BpsQuotaEstimate> = {};
+  const buckets = payload.groups?.find(
+    (group) => (group.displayName ?? group.display_name) === 'Account usage'
+  )?.buckets;
+  if (!Array.isArray(buckets)) return estimates;
+  const metrics = new Map(summary.map((metric) => [metric.key, metric]));
+  buckets.forEach((bucket, index) => {
+    const window = bucket.window?.trim();
+    if (!window || buckets.filter((item) => item.window?.trim() === window).length !== 1) return;
+    const total = metrics.get(`bps_estimated_${index}_total_usd`);
+    const remaining = metrics.get(`bps_estimated_${index}_remaining_usd`);
+    if (
+      !total ||
+      !remaining ||
+      total.format !== 'currency' ||
+      remaining.format !== 'currency' ||
+      total.currency !== 'USD' ||
+      remaining.currency !== 'USD' ||
+      !Number.isFinite(total.value) ||
+      total.value <= 0 ||
+      !Number.isFinite(remaining.value) ||
+      remaining.value < 0 ||
+      remaining.value > total.value
+    )
+      return;
+    estimates[window] = { total: total.value, remaining: remaining.value };
+  });
+  return estimates;
+}
+
+export function isBpsEstimateMetric(metric: PluginQuotaMetric): boolean {
+  return /^bps_estimated_[0-9]+_(remaining|total)_usd$/.test(metric.key);
+}
