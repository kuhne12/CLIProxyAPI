+export const resetBpsQuota = async (file: AuthFileItem, t: TFunction): Promise<PluginQuotaData> => {
+  const authIndex = normalizeAuthIndex(file.authIndex ?? file['auth_index']);
+  if (!authIndex) throw new Error(t('plugin_quota.missing_auth_index'));
+  if (selectedQuotaPluginId(file) !== 'bps') throw new Error(t('codex_quota.reset_not_confirmed'));
