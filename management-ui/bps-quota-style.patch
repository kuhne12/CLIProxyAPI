diff --git a/tests/quotaBalanceDetails.test.ts b/tests/quotaBalanceDetails.test.ts
new file mode 100644
index 0000000..f633053
--- /dev/null
+++ b/tests/quotaBalanceDetails.test.ts
@@ -0,0 +1,130 @@
+import { describe, expect, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { I18nextProvider } from 'react-i18next';
+import i18n from '@/i18n';
+import { CodexQuotaBody } from '@/features/quota/providers/codex/CodexQuotaBody';
+import { BpsQuotaBody } from '@/features/quota/providers/plugin/BpsQuotaBody';
+import { buildBpsQuotaGroups } from '@/features/quota/providers/plugin/bpsQuota';
+import { QUOTA_CLASS_KEYS, bindQuotaClasses } from '@/features/quota/types';
+import type { CodexQuotaState, PluginQuotaState } from '@/types';
+
+const locale = i18n.cloneInstance({ lng: 'zh-CN' });
+const classes = bindQuotaClasses(
+  Object.fromEntries(QUOTA_CLASS_KEYS.map((key) => [key, key])),
+  'test'
+);
+const renderCodex = (extra: Partial<CodexQuotaState> = {}) =>
+  renderToStaticMarkup(
+    createElement(
+      I18nextProvider,
+      { i18n: locale },
+      createElement(CodexQuotaBody, {
+        classes,
+        quota: { status: 'success', windows: [], ...extra },
+      })
+    )
+  );
+const renderBps = (extra: Partial<PluginQuotaState> = {}) =>
+  renderToStaticMarkup(
+    createElement(
+      I18nextProvider,
+      { i18n: locale },
+      createElement(BpsQuotaBody, {
+        classes,
+        quota: { status: 'success', pluginId: 'bps', groups: [], summary: [], ...extra },
+      })
+    )
+  );
+
+describe('shared BPS and Codex balance details', () => {
+  test('both providers expose a collapsed, read-only balance disclosure when balance is unknown', () => {
+    for (const html of [renderCodex(), renderBps()]) {
+      expect(html).toContain('<details');
+      expect(html).toContain('data-quota-balance');
+      expect(html).toContain('查看余额');
+      expect(html).toContain('上游未返回积分余额，不代表余额为零。');
+      expect(html).not.toContain(' open');
+      expect(html).not.toContain('$0.00');
+    }
+  });
+  test('zero credit balances are distinct from unavailable balances for both providers', () => {
+    for (const html of [
+      renderCodex({ creditBalance: '0' }),
+      renderBps({
+        summary: [{ key: 'credits_balance', label: 'Credits', value: 0, unit: 'credits' }],
+      }),
+    ]) {
+      expect(html).toContain('0 Credits');
+      expect(html).not.toContain('未提供');
+    }
+  });
+  test('Codex preserves decimal credit precision without inventing a dollar conversion', () => {
+    const html = renderCodex({ creditBalance: '12.50' });
+    expect(html).toContain('12.50 Credits');
+    expect(html).not.toContain('$12.50');
+  });
+  test('BPS preserves upstream unlimited credits through localized group normalization', () => {
+    const groups = buildBpsQuotaGroups(
+      {
+        groups: [
+          {
+            displayName: 'Credits',
+            buckets: [
+              { window: 'credits', description: 'Unlimited credits', remainingFraction: 1 },
+            ],
+          },
+        ],
+      },
+      locale.t
+    );
+    for (const html of [renderCodex({ creditsUnlimited: true }), renderBps({ groups })]) {
+      expect(html).toContain('无限额');
+      expect(html).not.toContain('未提供');
+    }
+  });
+  test('BPS uses Codex labels and remaining bar thresholds without treating estimates as credits', () => {
+    const html = renderBps({
+      subscription: { plan: 'self_serve_business_prolite' },
+      groups: buildBpsQuotaGroups(
+        {
+          groups: [
+            { displayName: 'Account usage', buckets: [{ window: '7d', remainingFraction: 0.26 }] },
+          ],
+        },
+        locale.t
+      ),
+      bpsEstimates: { '7d': { total: 449.03, remaining: 116.75 } },
+    });
+    expect(html).not.toContain('self_serve_business_prolite');
+    expect(html).toContain(locale.t('codex_quota.plan_business_premium'));
+    expect(html).toContain('周限额');
+    expect(html).toContain('aria-valuenow="26"');
+    expect(html).toContain('quotaBarFillLow');
+    expect(html).toContain('估算 ≈ $116.75');
+    expect(html).toContain('上游未返回积分余额');
+    expect(html).not.toContain('116.75 Credits');
+  });
+  test('multiple overlapping window estimates are listed separately, never added together', () => {
+    const html = renderBps({
+      groups: buildBpsQuotaGroups(
+        {
+          groups: [
+            {
+              displayName: 'Account usage',
+              buckets: [
+                { window: '5h', remainingFraction: 0.5 },
+                { window: '7d', remainingFraction: 0.5 },
+              ],
+            },
+          ],
+        },
+        locale.t
+      ),
+      bpsEstimates: { '5h': { total: 40, remaining: 20 }, '7d': { total: 100, remaining: 50 } },
+    });
+    expect(html).toContain('$20.00');
+    expect(html).toContain('$50.00');
+    expect(html).not.toContain('$70.00');
+  });
+});
